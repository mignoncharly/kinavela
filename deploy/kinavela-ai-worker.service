[Unit]
Description=Process Kinavela AI jobs
After=kinavela.service
Requires=kinavela.service

[Service]
Type=oneshot
User=mignon
Group=mignon
EnvironmentFile=/home/mignon/apps/kinavela/.env.production
ExecStart=/usr/bin/curl --fail --silent --show-error --request POST --header "Authorization: Bearer ${AI_WORKER_CRON_SECRET}" http://127.0.0.1:3020/api/cron/ai
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
