[Unit]
Description=Kinavela Next.js production application
Documentation=https://github.com/mignoncharly/kinavela
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mignon
Group=mignon
WorkingDirectory=/home/mignon/apps/kinavela
EnvironmentFile=/home/mignon/apps/kinavela/.env.production
Environment=NODE_ENV=production
Environment=PORT=3020
Environment=HOSTNAME=127.0.0.1
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStartPre=/usr/bin/node /home/mignon/apps/kinavela/scripts/validate-env.mjs
ExecStart=/usr/bin/node /home/mignon/apps/kinavela/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3020
Restart=on-failure
RestartSec=5s
TimeoutStartSec=45s
TimeoutStopSec=20s
KillSignal=SIGTERM
SuccessExitStatus=143 SIGTERM
SyslogIdentifier=kinavela
LogsDirectory=kinavela
LogsDirectoryMode=0750
StandardOutput=append:/var/log/kinavela/application.log
StandardError=append:/var/log/kinavela/error.log

# Service hardening
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/mignon/apps/kinavela/.next-production/cache /var/log/kinavela
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=false
UMask=0027

[Install]
WantedBy=multi-user.target
