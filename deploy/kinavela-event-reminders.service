[Unit]
Description=Dispatch Kinavela event reminders
After=kinavela.service
Requires=kinavela.service

[Service]
Type=oneshot
User=mignon
Group=mignon
EnvironmentFile=/home/mignon/apps/gtech/kinavela/.env.production
ExecStart=/usr/bin/curl --fail --silent --show-error --request POST --header "Authorization: Bearer ${EVENT_REMINDER_CRON_SECRET}" http://127.0.0.1:3020/api/cron/event-reminders
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

