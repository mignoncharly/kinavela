{
  "name": "kinavela",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first cultural community infrastructure for diaspora families.",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3020",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:check": "node scripts/check-localization.mjs --dictionaries-only && node scripts/check-localization.mjs --self-test",
    "i18n:report": "node scripts/check-localization.mjs",
    "blog:check": "node scripts/check-blog-voice.mjs",
    "blog:check:strict": "node scripts/check-blog-voice.mjs --strict",
    "blog:new": "node scripts/new-blog-post.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run i18n:check && npm run blog:check && npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate": "bash scripts/migrate.sh",
    "db:test": "bash scripts/test-database.sh",
    "check:email": "node scripts/check-email.mjs",
    "prepare": "husky",
    "env:check": "node scripts/validate-env.mjs",
    "security:scan": "node scripts/scan-secrets.mjs",
    "seo:indexnow": "node scripts/indexnow.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "release:qualification": "bash scripts/release-qualification.sh"
  },
  "dependencies": {
    "@sentry/nextjs": "10.69.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "lucide-react": "1.30.0",
    "marked": "^18.0.9",
    "next": "16.3.0",
    "nodemailer": "9.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "web-push": "3.6.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "type": "module"
}
