# Client-safe values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_APP_URL=https://www.kinavela.com
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=

# Server-only values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres

# Zoho Mail Europe
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@kinavela.com
SMTP_PASSWORD=your-zoho-app-password
EMAIL_FROM="Kinavela <contact@kinavela.com>"
EMAIL_REPLY_TO=contact@kinavela.com

# Optional Web Push delivery. Configure all three values together. The public
# key is embedded at build time; the private key must remain server-only.
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:contact@kinavela.com

# Server-side, replaceable city geocoder. The public Nominatim endpoint is
# suitable only for a small pilot and is protected by server caching/rate limits.
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org

# Server-only bearer token used by the local event reminder timer.
# Generate at least 32 random characters for each environment.
EVENT_REMINDER_CRON_SECRET=replace-with-a-long-random-secret

# Optional observability
# The public DSN is intentionally not secret. It enables browser reporting and
# must use the same regional Sentry project as the server DSN.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Keep the upload token in .env.sentry-build-plugin, never in runtime env.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=https://de.sentry.io/

NODE_ENV=production
PORT=3020
HOSTNAME=127.0.0.1
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ROOTS_FAMILY_MONTHLY=
STRIPE_PRICE_ROOTS_FAMILY_ANNUAL=

# Optional server-side AI. Keep disabled until provider transfer safeguards and
# controller approval are documented. The worker secret must be 32+ characters.
AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
AI_TRANSCRIPTION_MAX_BYTES=25000000
AI_REASONING_EFFORT=medium
AI_MAX_OUTPUT_TOKENS=2048
AI_PROCESSING_APPROVED=false
AI_WORKER_CRON_SECRET=
